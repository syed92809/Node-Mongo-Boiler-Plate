const joiCurrencySchema = Joi.object({
  fullName: Joi.string().required(),
  shortName: Joi.string().required().max(10),
  symbol: Joi.string().required(),
  createdAt: Joi.date().default(Date.now),
  isDeleted: Joi.boolean().default(false),
});


